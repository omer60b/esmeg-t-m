{
  "entities": {
    "TrainingDocument": {
      "title": "TrainingDocument",
      "description": "Corporate training module, instruction, or SOP document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["bilgi-islem", "depocu"] },
        "docNo": { "type": "string" },
        "subTitle": { "type": "string" },
        "scope": { "type": "string" },
        "targetUnit": { "type": "string" },
        "authorOrManager": { "type": "string" },
        "priority": { "type": "string", "enum": ["zorunlu", "kritik", "standart"] },
        "summary": { "type": "string" },
        "videoType": { "type": "string" },
        "videoUrl": { "type": "string" },
        "videoTitle": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "docNo"]
    },
    "TrainingCompletion": {
      "title": "TrainingCompletion",
      "description": "Digital completion record for a branch personnel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trainingId": { "type": "string" },
        "trainingTitle": { "type": "string" },
        "category": { "type": "string" },
        "branchId": { "type": "number" },
        "branchName": { "type": "string" },
        "personnelName": { "type": "string" },
        "signedAgreement": { "type": "boolean" },
        "completedAt": { "type": "string" },
        "certificateId": { "type": "string" }
      },
      "required": ["id", "trainingId", "branchId", "personnelName", "signedAgreement"]
    },
    "MeetingRoom": {
      "title": "MeetingRoom",
      "description": "Zoom-style live conference room for branches",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "hostName": { "type": "string" },
        "hostBranchId": { "type": "number" },
        "hostBranchName": { "type": "string" },
        "passcode": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "ended"] },
        "createdAt": { "type": "string" },
        "allowScreenShare": { "type": "boolean" }
      },
      "required": ["id", "title", "hostName", "status"]
    },
    "MeetingParticipant": {
      "title": "MeetingParticipant",
      "description": "Active participant in a Zoom meeting room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "branchName": { "type": "string" },
        "branchId": { "type": "number" },
        "role": { "type": "string", "enum": ["host", "co-host", "participant"] },
        "isAudioMuted": { "type": "boolean" },
        "isVideoOff": { "type": "boolean" },
        "isHandRaised": { "type": "boolean" },
        "isScreenSharing": { "type": "boolean" },
        "joinedAt": { "type": "string" }
      },
      "required": ["id", "name", "branchId", "role"]
    },
    "MeetingChatMessage": {
      "title": "MeetingChatMessage",
      "description": "In-meeting chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderBranch": { "type": "string" },
        "text": { "type": "string" },
        "target": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "senderId", "senderName", "text"]
    },
    "AppData": {
      "title": "AppData",
      "description": "Centralized training catalog, completions, and admin account state",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/appData/{docId}": {
      "schema": { "$ref": "#/entities/AppData" },
      "description": "Stores real-time training catalog, completion records, and admin accounts"
    },
    "/trainings/{trainingId}": {
      "schema": { "$ref": "#/entities/TrainingDocument" },
      "description": "Individual training module documents for real-time sync"
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/MeetingRoom" },
      "description": "Zoom style video meeting rooms"
    },
    "/meetings/{meetingId}/participants/{participantId}": {
      "schema": { "$ref": "#/entities/MeetingParticipant" },
      "description": "Active participants inside a Zoom meeting room"
    },
    "/meetings/{meetingId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/MeetingChatMessage" },
      "description": "In-meeting chat messages"
    }
  }
}
